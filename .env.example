GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
BACKEND_PORT=8000

# NVIDIA hosted model (server-only)
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3

BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
BEDROCK_API_KEY=

# Azure OpenAI-compatible model
AZURE_API_KEY=
AZURE_MODEL_ID=gpt-6.1-sol
AZURE_BASE_URL=https://project-t3-resource.services.ai.azure.com/openai/v1

# Sarvam AI (OpenAI-compatible v2 endpoint)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v2
SARVAM_MAX_TOKENS=4096

# Monitoring (all optional; never required for local development)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
WIREUP_ENV=beta

# Invite-only beta tenancy (disabled for local development by default)
WIREUP_BETA_AUTH_ENABLED=false
WIREUP_BETA_DEV_LOGIN=false
WIREUP_ADMIN_EMAIL=
WIREUP_BETA_DB=backend/data/beta.sqlite3
WIREUP_COOKIE_SECURE=false
WIREUP_COOKIE_SAMESITE=lax
RESEND_API_KEY=
RESEND_FROM_EMAIL=WireUp Beta <beta@your-domain.com>
WIREUP_PUBLIC_APP_URL=http://127.0.0.1:5173
WIREUP_ALLOWED_ORIGINS=https://your-project.vercel.app
